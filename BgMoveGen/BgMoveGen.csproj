<Project Sdk="Microsoft.NET.Sdk">

  <!-- Framework / nullable / usings / warnings-as-errors / doc-file are
       repo policy — see ..\Directory.Build.props. The two below are
       per-project capability grants, not policy:
         AllowUnsafeBlocks — required for the Interop pointer marshalling
                             (BgBoardState* exports and helpers).
         PublishAot        — this is the shipping project, published to a
                             NativeAOT DLL; the test project must not be AOT. -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BgMoveGen.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BgDataTypes_Lib\BgDataTypes_Lib\BgDataTypes_Lib.csproj" />
  </ItemGroup>

</Project>