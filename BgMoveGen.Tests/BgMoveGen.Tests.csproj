<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- AllowUnsafeBlocks — required for InteropTests, which take pointers to
         BgBoardState buffers to drive the interop core directly. A per-project
         capability grant, not repo policy; see ..\Directory.Build.props. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The one exception to the repo-wide policy in Directory.Build.props:
         test classes are not a consumed API, so a doc file buys nothing and
         CS1591 would only add noise. Warnings-as-errors still applies. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BgMoveGen\BgMoveGen.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  
</Project>